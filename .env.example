# OLI Design Studio Environment Variables

# Web3Forms API Access Key for contact enquiry submissions
# Required for production builds (build:prod / OLI_PRODUCTION=1).
# If unset during local development, the contact form simulates submission in mock mode.
# Get an access key from https://web3forms.com and restrict it to your production domain (olidesignstudio.in).
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Production Flag (Set automatically by npm run build:prod)
# OLI_PRODUCTION=1
